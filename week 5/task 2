import java.util.*;

public class task {

    static int birthday(int[] chocolate, int day, int month) {
        if (month > chocolate.length) {
            return 0;
        }

        int sum = 0;
        int ways = 0;

        for (int i = 0; i < month; i++) {
            sum += chocolate[i];
        }

        if (sum == day) {
            ways++;
        }

        for (int i = month; i < chocolate.length; i++) {
            sum += chocolate[i];
            sum -= chocolate[i - month];

            if (sum == day) {
                ways++;
            }
        }

        return ways;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] chocolate = new int[n];

        for (int i = 0; i < n; i++) {
            chocolate[i] = sc.nextInt();
        }

        int day = sc.nextInt();
        int month = sc.nextInt();

        System.out.println(birthday(chocolate, day, month));
        sc.close();
    }
}
