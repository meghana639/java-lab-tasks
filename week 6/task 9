import java.util.*;

public class task {

    static String longestPalindrome(String s) {
        if (s.isEmpty()) {
            return "";
        }

        StringBuilder transformed = new StringBuilder("^");

        for (int i = 0; i < s.length(); i++) {
            transformed.append("#");
            transformed.append(s.charAt(i));
        }

        transformed.append("#$");

        char[] characters = transformed.toString().toCharArray();
        int[] palindrome = new int[characters.length];

        int center = 0;
        int right = 0;

        for (int i = 1; i < characters.length - 1; i++) {
            int mirror = 2 * center - i;

            if (i < right) {
                palindrome[i] =
                        Math.min(right - i, palindrome[mirror]);
            }

            while (characters[i + palindrome[i] + 1]
                    == characters[i - palindrome[i] - 1]) {
                palindrome[i]++;
            }

            if (i + palindrome[i] > right) {
                center = i;
                right = i + palindrome[i];
            }
        }

        int maximumLength = 0;
        int centerIndex = 0;

        for (int i = 1; i < palindrome.length - 1; i++) {
            if (palindrome[i] > maximumLength) {
                maximumLength = palindrome[i];
                centerIndex = i;
            }
        }

        int start = (centerIndex - maximumLength) / 2;

        return s.substring(start, start + maximumLength);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String s = sc.nextLine();

        System.out.println(longestPalindrome(s));
        sc.close();
    }
}
