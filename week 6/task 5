import java.util.*;

public class task {

    static int marsExploration(String received) {
        String expected = "SOS";
        int changes = 0;

        for (int i = 0; i < received.length(); i++) {
            if (received.charAt(i) != expected.charAt(i % 3)) {
                changes++;
            }
        }

        return changes;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String received = sc.nextLine();

        System.out.println(marsExploration(received));
        sc.close();
    }
}
