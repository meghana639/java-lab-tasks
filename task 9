        boolean passed = false;

        if (op.equals("+")) {
            int result = a + b;
            if (result == 30)
                passed = true;
        } else if (op.equals("/")) {
            if (b != 0) {
                int result = a / b;
                passed = true;
            }
        }

        if (passed)
            System.out.println("Test Passed");
