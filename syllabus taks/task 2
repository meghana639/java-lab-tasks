import java.util.*;
import java.util.stream.*;

class java {

    static class Reading {
        String sensorId;
        double temperature;

        Reading(String sensorId, double temperature) {
            this.sensorId = sensorId;
            this.temperature = temperature;
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        List<Reading> readings = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            String id = sc.next();
            double temp = sc.nextDouble();

            readings.add(new Reading(id, temp));
        }

        Map<String, Double> averages = readings.stream()

                // Step 1: Filter temperature > 50
                .filter(r -> r.temperature > 50)

                // Step 2 & 3: Group by sensor ID and calculate average
                .collect(Collectors.groupingBy(
                        r -> r.sensorId,
                        Collectors.averagingDouble(r -> r.temperature)
                ));

        // Step 4: Sort by average descending
        averages.entrySet()
                .stream()
                .sorted((a, b) ->
                        Double.compare(b.getValue(), a.getValue()))
                .forEach(entry ->
                        System.out.println(
                                entry.getKey() + " " + entry.getValue()
                        ));
    }
}
