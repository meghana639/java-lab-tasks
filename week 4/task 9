import java.util.*;

public class task {

    static int[][] matrixBlockSum(int[][] matrix, int k) {
        int rows = matrix.length;
        int columns = matrix[0].length;

        int[][] prefix = new int[rows + 1][columns + 1];
        int[][] answer = new int[rows][columns];

        // Construct the prefix-sum matrix
        for (int i = 1; i <= rows; i++) {
            for (int j = 1; j <= columns; j++) {
                prefix[i][j] = matrix[i - 1][j - 1]
                        + prefix[i - 1][j]
                        + prefix[i][j - 1]
                        - prefix[i - 1][j - 1];
            }
        }

        // Find the block sum for each position
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < columns; j++) {
                int row1 = Math.max(0, i - k);
                int column1 = Math.max(0, j - k);

                int row2 = Math.min(rows - 1, i + k);
                int column2 = Math.min(columns - 1, j + k);

                answer[i][j] =
                        prefix[row2 + 1][column2 + 1]
                        - prefix[row1][column2 + 1]
                        - prefix[row2 + 1][column1]
                        + prefix[row1][column1];
            }
        }

        return answer;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int rows = sc.nextInt();
        int columns = sc.nextInt();

        int[][] matrix = new int[rows][columns];

        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < columns; j++) {
                matrix[i][j] = sc.nextInt();
            }
        }

        int k = sc.nextInt();

        int[][] result = matrixBlockSum(matrix, k);

        for (int[] row : result) {
            for (int value : row) {
                System.out.print(value + " ");
            }
            System.out.println();
        }

        sc.close();
    }
}
