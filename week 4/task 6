import java.util.*;

public class task {

    static void moveZeroes(int[] nums) {
        int position = 0;

        // Move all non-zero elements to the front
        for (int num : nums) {
            if (num != 0) {
                nums[position] = num;
                position++;
            }
        }

        // Fill the remaining positions with zeroes
        while (position < nums.length) {
            nums[position] = 0;
            position++;
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] nums = new int[n];

        for (int i = 0; i < n; i++) {
            nums[i] = sc.nextInt();
        }

        moveZeroes(nums);

        for (int num : nums) {
            System.out.print(num + " ");
        }

        sc.close();
    }
}
