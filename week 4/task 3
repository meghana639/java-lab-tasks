import java.util.*;

public class java {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[] alice = new int[3];
        int[] bob = new int[3];

        for (int i = 0; i < 3; i++) {
            alice[i] = sc.nextInt();
        }

        for (int i = 0; i < 3; i++) {
            bob[i] = sc.nextInt();
        }

        int alicePoints = 0;
        int bobPoints = 0;

        for (int i = 0; i < 3; i++) {
            if (alice[i] > bob[i]) {
                alicePoints++;
            } else if (alice[i] < bob[i]) {
                bobPoints++;
            }
        }

        System.out.println(alicePoints + " " + bobPoints);
        sc.close();
    }
}
